{
  "name": "fileflow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FileFlow - a free, privacy-first file and data conversion workspace. Convert, clean, filter and export CSV, JSON, JSONL and TXT entirely in your browser.",
  "author": "KK (@0xkillcoin)",
  "license": "MIT",
  "homepage": "https://iiiiiiiiiiiiiKK.github.io/fileflow/",
  "repository": {
    "type": "git",
    "url": "https://github.com/iiiiiiiiiiiiiKK/fileflow.git"
  },
  "bugs": {
    "url": "https://github.com/iiiiiiiiiiiiiKK/fileflow/issues"
  },
  "keywords": [
    "csv",
    "json",
    "jsonl",
    "ndjson",
    "csv-to-json",
    "json-to-csv",
    "data-cleaning",
    "data-converter",
    "file-converter",
    "privacy",
    "local-first",
    "offline",
    "browser"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "screenshots": "node scripts/screenshots.mjs",
    "audit:layout": "node scripts/audit-layout.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  }
}
